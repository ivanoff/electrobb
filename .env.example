TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TARGET_TITLE=TargetChannelTitle
# If names collide, use the positive Telegram ID, without -100:
# TARGET_ID=
BOT_COMMAND="ІНФОРМАЦІЯ ЩОДО ВІДКЛЮЧЕНЬ"
# Alternative to BOT_COMMAND, never set both:
# BOT_BUTTON=
BOT_ACCOUNT=
TIMEZONE=Europe/Kyiv
# Remove both QUIET_HOURS variables to disable quiet hours.
QUIET_HOURS_START=22:00
QUIET_HOURS_END=09:00
SILENT_HOURS_START=20:00
SILENT_HOURS_END=11:00
# Optional heartbeat receiver: set both to enable.
# HEARTBEAT_PORT=3000
# HEARTBEAT_TOKEN=replace-with-a-long-random-token

# Minutes without heartbeat before confirming a power outage.
HEARTBEAT_TIMEOUT_MINUTES=5
